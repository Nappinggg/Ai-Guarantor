# NEVER commit .env. TEST keys only.
STRIPE_SECRET_KEY=sk_test_...
# Filled in after scripts/test_stripe.py first run (test connected account for the contractor)
STRIPE_CONNECTED_ACCOUNT=

# Gemini key from https://aistudio.google.com -> Get API key (used by the agent AND Cognee)
GEMINI_API_KEY=

# Cognee config (reads the same Gemini key)
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.8-flash
LLM_API_KEY=${GEMINI_API_KEY}
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIMENSIONS=3072
EMBEDDING_API_KEY=${GEMINI_API_KEY}

AGENT_MODELS=gemini/gemini-3.1-flash-lite,gemini/gemini-flash-lite-latest

GITHUB_TOKEN=
